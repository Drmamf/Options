[Unit]
Description=ReyT Bale Legacy Notifier
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=reyt
Group=reyt
WorkingDirectory=/opt/reyt-github/bale
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPTIONS_CONFIG_FILE=/etc/reyt/bale/settings.ini
ExecStart=/opt/reyt-venv/bin/python /opt/reyt-github/bale/ReyT_bale_notifier_unified.py --watch
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

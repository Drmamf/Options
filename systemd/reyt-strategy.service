[Unit]
Description=ReyT Options Strategy and Paper Trading Engine
After=network-online.target mysql.service reyt-collector.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=reyt
Group=reyt
WorkingDirectory=/opt/reyt-github/strategy
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPTIONS_CONFIG_FILE=/etc/reyt/strategy/settings.ini
ExecStart=/opt/reyt-venv/bin/python /opt/reyt-github/strategy/ReyT_strategy_engine_unified_1b_execution_status_v2.py --watch --interval 1
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

[Unit]
Description=ReyT Protective Put Paper Trading Engine
After=network-online.target mysql.service reyt-collector.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=reyt
Group=reyt
WorkingDirectory=/opt/reyt-github/strategy

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPTIONS_CONFIG_FILE=/etc/reyt/strategy/settings.ini
Environment=REYT_BASE_ENGINE=/opt/reyt-github/strategy/ReyT_strategy_engine_unified_1b_execution_status_v2.py

# Independent paper account for Protective Put.
Environment=PAPER_ACCOUNT_NAME=paper_100m_pp_itm10
Environment=PAPER_INITIAL_CAPITAL_TOMAN=100000000
Environment=PAPER_AUTO_TRADE=yes

# Mirror of the active Covered Call paper policy.
Environment=PAPER_PP_MIN_EXPECTED_ANNUALIZED_RETURN_PCT=50
Environment=PAPER_PP_MIN_ITM_PCT=10
Environment=PAPER_PP_MIN_CAPITAL_TOMAN=200000
Environment=PAPER_PP_MAX_CAPITAL_TOMAN=10000000
Environment=PAPER_MIN_DAYS_TO_EXPIRY=5
Environment=PAPER_MAX_DAYS_TO_EXPIRY=180

ExecStart=/opt/reyt-venv/bin/python /opt/reyt-github/strategy/ReyT_strategy_engine_protective_put_only.py --watch --interval 1

Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
